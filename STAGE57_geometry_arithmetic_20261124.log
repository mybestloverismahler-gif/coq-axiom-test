Coq < sum_exists
     : forall O E E' : Tpoint,
       ~ Col O E E' ->
       forall A B : Tpoint,
       Col O E A -> Col O E B -> exists C : Tpoint, Sum O E E' A B C
where
?Tn : [ |- Tarski_neutral_dimensionless]
?TnEQD : [ |- Tarski_neutral_dimensionless_with_decidable_point_equality ?Tn]
?T2D : [ |- Tarski_2D ?TnEQD]
?TE : [ |- Tarski_euclidean ?TnEQD]

Coq < prod_exists
     : forall O E E' : Tpoint,
       ~ Col O E E' ->
       forall A B : Tpoint,
       Col O E A -> Col O E B -> exists C : Tpoint, Prod O E E' A B C
where
?Tn : [ |- Tarski_neutral_dimensionless]
?TnEQD : [ |- Tarski_neutral_dimensionless_with_decidable_point_equality ?Tn]
?T2D : [ |- Tarski_2D ?TnEQD]
?TE : [ |- Tarski_euclidean ?TnEQD]

