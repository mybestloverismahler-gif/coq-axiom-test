sum_exists_2D_local
     : (forall A B C D : Tpoint,
        (exists X : Tpoint, Col X A B /\ Col X C D) \/
        ~ (exists X : Tpoint, Col X A B /\ Col X C D)) ->
       forall O E E' : Tpoint,
       ~ Col O E E' ->
       forall A B : Tpoint,
       Col O E A -> Col O E B -> exists C : Tpoint, Sum O E E' A B C
where
?Tn : [ |- Tarski_neutral_dimensionless]
?Td : [ |- Tarski_neutral_dimensionless_with_decidable_point_equality ?Tn]
?T2 : [ |- Tarski_2D ?Td]
?TE : [ |- Tarski_euclidean ?Td]
