                        (l : list (BinNums.positive * BinNums.positive)),
                      Sorted.HdRel
                        (fun t1 t2 : sets.SetOfPairsOfPositiveOrderedType.t
                         =>
                         let ft1 := sets.fstpp t1 in
                         let ft2 := sets.fstpp t2 in
                         let st1 := sets.sndpp t1 in
                         let st2 := sets.sndpp t2 in
                         if BinPos.Pos.eqb ft1 ft2
                         then BinPos.Pos.lt st1 st2
                         else BinPos.Pos.lt ft1 ft2) x l <->
                      sets.SP.Raw.inf x l = true
