collect_diffs : forall (COLTpoint : Type) (A B : COLTpoint),
                A <> B ->
                forall (pa pb : BinNums.positive) 
                  (sp : sets.SP.t) (interp : BinNums.positive -> COLTpoint),
                interp pa = A ->
                interp pb = B ->
                sp_ok sp interp -> sp_ok (sets.SP.add (pa, pb) sp) interp
collect_cols : forall (COLTpoint : Type)
                 (CTCol : COLTpoint -> COLTpoint -> COLTpoint -> Prop),
               tactics_axioms.Col_theory COLTpoint CTCol ->
               forall A B C : COLTpoint,
               CTCol A B C ->
               forall (pa pb pc : BinNums.positive) 
                 (ss : sets.SS.t) (interp : BinNums.positive -> COLTpoint),
               interp pa = A ->
               interp pb = B ->
               interp pc = C ->
               ss_ok ss interp ->
               ss_ok
                 (sets.SS.add
                    (sets.S.add pa
                       (sets.S.add pb (sets.S.add pc sets.S.empty))) ss)
                 interp
