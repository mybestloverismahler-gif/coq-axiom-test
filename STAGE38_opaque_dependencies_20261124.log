sets.SP.Raw.MX.compare_lt_iff : forall
                                  x y : BinNums.positive * BinNums.positive,
                                (fun
                                   t1
                                    t2 : BinNums.positive * BinNums.positive
                                 =>
                                 let ft1 := sets.fstpp t1 in
                                 let ft2 := sets.fstpp t2 in
                                 let st1 := sets.sndpp t1 in
                                 let st2 := sets.sndpp t2 in
                                 match BinPos.Pos.compare ft1 ft2 with
                                 | Eq => BinPos.Pos.compare st1 st2
                                 | Datatypes.Lt => Datatypes.Lt
                                 | Datatypes.Gt => Datatypes.Gt
                                 end) x y = Datatypes.Lt <->
                                (fun
                                   t1
                                    t2 : sets.SetOfPairsOfPositiveOrderedType.t
                                 =>
                                 let ft1 := sets.fstpp t1 in
                                 let ft2 := sets.fstpp t2 in
                                 let st1 := sets.sndpp t1 in
                                 let st2 := sets.sndpp t2 in
                                 if BinPos.Pos.eqb ft1 ft2
                                 then BinPos.Pos.lt st1 st2
                                 else BinPos.Pos.lt ft1 ft2) x y
sets.S.Raw.MX.compare_lt_iff : forall x y : BinNums.positive,
                               (fix compare
                                  (x0 y0 : BinNums.positive) {struct x0} :
                                    comparison :=
                                  match x0 with
                                  | BinNums.xI x1 =>
                                      match y0 with
                                      | BinNums.xI y1 => compare x1 y1
                                      | _ => Datatypes.Gt
                                      end
                                  | BinNums.xO x1 =>
                                      match y0 with
                                      | BinNums.xO y1 => compare x1 y1
                                      | _ => Datatypes.Lt
                                      end
                                  | BinNums.xH =>
                                      match y0 with
                                      | BinNums.xI _ => Datatypes.Lt
                                      | BinNums.xO _ => Datatypes.Gt
                                      | BinNums.xH => Eq
                                      end
                                  end) x y = Datatypes.Lt <->
                               OrdersEx.PositiveOrderedTypeBits.bits_lt x y
