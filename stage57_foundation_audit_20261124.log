Record
Hilbert_neutral_dimensionless : Type := Build_Hilbert_neutral_dimensionless
  { Point : Type;
    Line : Type;
    Plane : Type;
    EqL : Line -> Line -> Prop;
    EqL_Equiv : Equivalence EqL;
    EqP : Plane -> Plane -> Prop;
    EqP_Equiv : Equivalence EqP;
    IncidL : Point -> Line -> Prop;
    IncidP : Point -> Plane -> Prop;
    IncidL_morphism : forall (P : Point) (l m : Line),
                      IncidL P l -> EqL l m -> IncidL P m;
    IncidL_dec : forall (P : Point) (l : Line), IncidL P l \/ ~ IncidL P l;
    IncidP_morphism : forall (M : Point) (p q : Plane),
                      IncidP M p -> EqP p q -> IncidP M q;
    IncidP_dec : forall (M : Point) (p : Plane), IncidP M p \/ ~ IncidP M p;
    eq_dec_pointsH : forall A B : Point, A = B \/ A <> B;
    line_existence : forall A B : Point,
                     A <> B -> exists l : Line, IncidL A l /\ IncidL B l;
    line_uniqueness : forall (A B : Point) (l m : Line),
                      A <> B ->
                      IncidL A l ->
                      IncidL B l -> IncidL A m -> IncidL B m -> EqL l m;
    two_points_on_line : forall l : Line,
                         {A : Point &
                         {B : Point | IncidL B l /\ IncidL A l /\ A <> B}};
    ColH := fun A B C : Point =>
            exists l : Line, IncidL A l /\ IncidL B l /\ IncidL C l;
    PP : Point;
    PQ : Point;
    PR : Point;
    lower_dim_2 : PP <> PQ /\ PQ <> PR /\ PP <> PR /\ ~ ColH PP PQ PR;
    plane_existence : forall A B C : Point,
                      ~ ColH A B C ->
                      exists p : Plane,
                        IncidP A p /\ IncidP B p /\ IncidP C p;
    one_point_on_plane : forall p : Plane, {A : Point | IncidP A p};
    plane_uniqueness : forall (A B C : Point) (p q : Plane),
                       ~ ColH A B C ->
                       IncidP A p ->
                       IncidP B p ->
                       IncidP C p ->
                       IncidP A q -> IncidP B q -> IncidP C q -> EqP p q;
    IncidLP := fun (l : Line) (p : Plane) =>
               forall A : Point, IncidL A l -> IncidP A p;
    line_on_plane : forall (A B : Point) (l : Line) (p : Plane),
                    A <> B ->
                    IncidL A l ->
                    IncidL B l -> IncidP A p -> IncidP B p -> IncidLP l p;
    BetH : Point -> Point -> Point -> Prop;
    between_diff : forall A B C : Point, BetH A B C -> A <> C;
    between_col : forall A B C : Point, BetH A B C -> ColH A B C;
    between_comm : forall A B C : Point, BetH A B C -> BetH C B A;
    between_out : forall A B : Point, A <> B -> exists C : Point, BetH A B C;
    between_only_one : forall A B C : Point, BetH A B C -> ~ BetH B C A;
    cut := fun (l : Line) (A B : Point) =>
           ~ IncidL A l /\
           ~ IncidL B l /\ (exists I : Point, IncidL I l /\ BetH A I B);
    pasch : forall (A B C : Point) (l : Line) (p : Plane),
            ~ ColH A B C ->
            IncidP A p ->
            IncidP B p ->
            IncidP C p ->
            IncidLP l p ->
            ~ IncidL C l -> cut l A B -> cut l A C \/ cut l B C;
    CongH : Point -> Point -> Point -> Point -> Prop;
    cong_permr : forall A B C D : Point, CongH A B C D -> CongH A B D C;
    outH := fun P A B : Point => BetH P A B \/ BetH P B A \/ P <> A /\ A = B;
    cong_existence : forall (A B A' P : Point) (l : Line),
                     A <> B ->
                     A' <> P ->
                     IncidL A' l ->
                     IncidL P l ->
                     exists B' : Point,
                       IncidL B' l /\ outH A' P B' /\ CongH A' B' A B;
    cong_pseudo_transitivity : forall A B C D E F : Point,
                               CongH A B C D ->
                               CongH A B E F -> CongH C D E F;
    disjoint := fun A B C D : Point =>
                ~ (exists P : Point, BetH A P B /\ BetH C P D);
    addition : forall A B C A' B' C' : Point,
               ColH A B C ->
               ColH A' B' C' ->
               disjoint A B B C ->
               disjoint A' B' B' C' ->
               CongH A B A' B' -> CongH B C B' C' -> CongH A C A' C';
    CongaH : Point -> Point -> Point -> Point -> Point -> Point -> Prop;
    conga_refl : forall A B C : Point, ~ ColH A B C -> CongaH A B C A B C;
    conga_comm : forall A B C : Point, ~ ColH A B C -> CongaH A B C C B A;
    conga_permlr : forall A B C D E F : Point,
                   CongaH A B C D E F -> CongaH C B A F E D;
    same_side := fun (A B : Point) (l : Line) =>
                 exists P : Point, cut l A P /\ cut l B P;
    same_side' := fun A B X Y : Point =>
                  X <> Y /\
                  (forall l : Line,
                   IncidL X l -> IncidL Y l -> same_side A B l);
    conga_out_conga : forall A B C D E F A' C' D' F' : Point,
                      CongaH A B C D E F ->
                      outH B A A' ->
                      outH B C C' ->
                      outH E D D' -> outH E F F' -> CongaH A' B C' D' E F';
    cong_4_existence : forall A B C O X P : Point,
                       ~ ColH P O X ->
                       ~ ColH A B C ->
                       exists Y : Point,
                         CongaH A B C X O Y /\ same_side' P Y O X;
    cong_4_uniqueness : forall A B C O P X Y Y' : Point,
                        ~ ColH P O X ->
                        ~ ColH A B C ->
                        CongaH A B C X O Y ->
                        CongaH A B C X O Y' ->
                        same_side' P Y O X ->
                        same_side' P Y' O X -> outH O Y Y';
    cong_5 : forall A B C A' B' C' : Point,
             ~ ColH A B C ->
             ~ ColH A' B' C' ->
             CongH A B A' B' ->
             CongH A C A' C' ->
             CongaH B A C B' A' C' -> CongaH A B C A' B' C' }.

Arguments Build_Hilbert_neutral_dimensionless (Point Line Plane)%type_scope
  EqL%function_scope EqL_Equiv EqP%function_scope 
  EqP_Equiv
  (IncidL IncidP IncidL_morphism IncidL_dec IncidP_morphism IncidP_dec
   eq_dec_pointsH line_existence line_uniqueness
   two_points_on_line)%function_scope PP PQ PR lower_dim_2
  (plane_existence one_point_on_plane plane_uniqueness line_on_plane BetH
   between_diff between_col between_comm between_out between_only_one pasch
   CongH cong_permr cong_existence cong_pseudo_transitivity addition CongaH
   conga_refl conga_comm conga_permlr conga_out_conga cong_4_existence
   cong_4_uniqueness cong_5)%function_scope
Record
Hilbert_neutral_2D (Hi : Hilbert_neutral_dimensionless)
  : Prop := Build_Hilbert_neutral_2D
  { pasch_2D : forall (A B C : Point) (l : Line),
               ~ ColH A B C ->
               ~ IncidL C l -> cut l A B -> cut l A C \/ cut l B C }.

Arguments Hilbert_neutral_2D Hi
Arguments Build_Hilbert_neutral_2D Hi pasch_2D%function_scope
Record
Hilbert_euclidean_ID (Hi : Hilbert_neutral_dimensionless)
(H_euclidean : Hilbert_euclidean Hi) : Prop := Build_Hilbert_euclidean_ID
  { decidability_of_intersection : forall l m : Line,
                                   (exists I : Point,
                                      IncidL I l /\ IncidL I m) \/
                                   ~
                                   (exists I : Point,
                                      IncidL I l /\ IncidL I m) }.

Arguments Hilbert_euclidean_ID {Hi} H_euclidean
Arguments Build_Hilbert_euclidean_ID Hi H_euclidean
  decidability_of_intersection%function_scope
Axioms:
ClassicalDedekindReals.sig_not_dec : forall P : Prop, {~ ~ P} + {~ P}
ClassicalDedekindReals.sig_forall_dec
  : forall P : nat -> Prop,
    (forall n : nat, {P n} + {~ P n}) ->
    {n : nat | ~ P n} + {forall n : nat, P n}
FunctionalExtensionality.functional_extensionality_dep
  : forall (A : Type) (B : A -> Type) (f g : forall x : A, B x),
    (forall x : A, f x = g x) -> f = g
