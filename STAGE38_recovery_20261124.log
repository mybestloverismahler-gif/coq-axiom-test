Coq < between_one
     : forall A B C : hilbert_axioms.Point,
       A <> B ->
       A <> C ->
       B <> C ->
       hilbert_axioms.ColH A B C ->
       hilbert_axioms.BetH A B C \/
       hilbert_axioms.BetH B C A \/ hilbert_axioms.BetH B A C
where
?Hi : [ |- hilbert_axioms.Hilbert_neutral_dimensionless]

Coq < betH_trans0
     : forall A B C D : hilbert_axioms.Point,
       hilbert_axioms.BetH A B C ->
       hilbert_axioms.BetH A C D ->
       hilbert_axioms.BetH B C D /\ hilbert_axioms.BetH A B D
where
?Hi : [ |- hilbert_axioms.Hilbert_neutral_dimensionless]

Coq < betH2_out
     : forall A B C D : hilbert_axioms.Point,
       B <> C ->
       hilbert_axioms.BetH A B D ->
       hilbert_axioms.BetH A C D ->
       hilbert_axioms.BetH A B C \/ hilbert_axioms.BetH A C B
where
?Hi : [ |- hilbert_axioms.Hilbert_neutral_dimensionless]

